# Copy this file to .env and fill in real values before running the server.
# NEVER commit .env. Every secret below must be unique per environment.

# ---------------------------------------------------------------- core
# PostgreSQL connection string used by Prisma.
DATABASE_URL="postgresql://restaurant_app:CHANGE_ME@localhost:5432/restaurant_order?schema=public"
PORT=4000
NODE_ENV=development            # production turns on the stricter rules marked (prod) below

# Secret used to sign STAFF JWTs. (prod) at least 32 characters.
JWT_SECRET="CHANGE_ME_TO_A_LONG_RANDOM_STRING_AT_LEAST_32_CHARS"
JWT_EXPIRES_IN="12h"

# Comma-separated list of origins allowed to call the API (the frontend's URL(s)).
CORS_ORIGIN="http://localhost:8000"
# Public base URL of the static frontend (used in e-mails / Telegram messages).
FRONTEND_BASE_URL="http://localhost:8000"
# Behind a reverse proxy set this (e.g. 1) so rate limits / login lockout see the real client IP.
# TRUST_PROXY=1

# ---------------------------------------------------------------- guest accounts (client JWT)
# A DIFFERENT secret from JWT_SECRET: a staff token can never be replayed as a client token.
# (prod) required, at least 32 characters, must differ from JWT_SECRET. In development it is derived from JWT_SECRET.
# CLIENT_JWT_SECRET="CHANGE_ME_ANOTHER_LONG_RANDOM_STRING_AT_LEAST_32_CHARS"
CLIENT_JWT_EXPIRES_IN="8h"
LOGIN_MAX_FAILURES=5            # failed logins per (e-mail, IP) before a lockout
LOGIN_LOCKOUT_MINUTES=15

# ---------------------------------------------------------------- kiosk terminals
# (prod) always enforced. Setting false is for legacy local tooling only and is ignored in production.
KIOSK_TOKEN_ENFORCED=true
# After a table session ends, its tracker/receipt stay readable for the guest this long.
KIOSK_TOKEN_GRACE_MINUTES=30
# (prod) REQUIRED: the pre-registered secret of every physical terminal, "monitorNumber:secret" pairs.
# Open the kiosk URL once as  index.html?monitor=3&device=<secret>  and the browser remembers it.
# KIOSK_DEVICE_SECRETS="1:long-random-secret-for-monitor-1,2:long-random-secret-for-monitor-2"

# ---------------------------------------------------------------- loyalty
CASHBACK_RATE=0.05              # earned on the MONEY actually paid, rounded down to whole bonuses (1 bonus = 1 KZT)
CASHBACK_REDEMPTION_CAP=0.5     # max share of an order that bonuses may cover

# ---------------------------------------------------------------- identity / 21+
# DEMO identity check is a classroom simulation. It is always OFF in production, whatever this says.
DEMO_IDENTITY_VERIFICATION=true
IDENTITY_VERIFICATION_TTL_DAYS=365

# ---------------------------------------------------------------- receipts (DEMO unless a fiscal provider is plugged in)
# Server-side only. Defaults are clearly marked demo values.
# MERCHANT_NAME="Демо-ресторан Restaurant Order"
# MERCHANT_ADDRESS="Алматы, пр. Абылай хана, 104 - демонстрационные данные"
# MERCHANT_TAX_ID="Тестовый БИН, не действителен"
# KKM_SERIAL=
# KKM_REG_NUMBER=
# OFD_NAME=
# MERCHANT_VAT_RATE_PERCENT=12  # unset = VAT is not printed (no unconfirmed rate is ever invented)

# ---------------------------------------------------------------- receipt delivery (optional)
# E-mail via SMTP. Without SMTP_HOST + SMTP_FROM the endpoint answers 503 DELIVERY_PROVIDER_NOT_CONFIGURED.
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM="Restaurant <no-reply@example.com>"
# SMTP_SECURE=false
# Telegram bot: /start /login /orders /receipts /logout /help, guest paid-receipt deep links,
# optional auto-send (explicit client opt-in). No separate polling mode is enabled.
# Webhook: HTTPS POST /api/integrations/telegram/webhook, header X-Telegram-Bot-Api-Secret-Token.
# For bot-initiated login from a PHONE, FRONTEND_BASE_URL must be publicly reachable (HTTPS).
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_BOT_USERNAME=
# TELEGRAM_WEBHOOK_SECRET=

# ---------------------------------------------------------------- seeds (see README)
# (prod) the first admin is created by `npm run seed:reference` ONLY if this is set; no default passwords in production.
# SEED_ADMIN_PASSWORD=
