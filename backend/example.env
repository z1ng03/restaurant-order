# Copy this file to .env and fill in real values before running the server.

# PostgreSQL connection string used by Prisma.
DATABASE_URL="postgresql://restaurant_app:1234@localhost:5432/restaurant_order?schema=public"

# Port the Express API listens on.
PORT=4000

# Secret used to sign staff JWTs. Use a long random string in production.
JWT_SECRET="ILYA_MIRON_ALBERT"

# How long a staff login stays valid.
JWT_EXPIRES_IN="12h"

# Comma-separated list of origins allowed to call the API (the frontend's URL(s)).
CORS_ORIGIN="http://localhost:8000"
