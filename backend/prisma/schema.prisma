// ============================================================================
// Restaurant table-monitor ordering system - Prisma schema
//
// This mirrors the ERD from "Database - Лист1.pdf" field-for-field, using
// VARCHAR(n)-with-allowed-values (documented in comments) exactly like the
// source spreadsheet did, rather than native Postgres enums - so the columns
// line up 1:1 with what's in the spec.
//
// A few tables/columns were ADDED beyond the given ERD because the written
// business flow (Техническое задание) needs them and the ERD didn't have a
// place for them yet. Each is marked "// ADDED:" with the reason, following
// the same "Добавил / Почему" reasoning style used in the ТЗ itself:
//
//   1) cart_items_options  - the ТЗ says a client picks dish options when
//      adding to the cart, but the ERD only had order_item_options (options
//      are recorded once an order exists). Without this table a chosen
//      option can't survive from "add to cart" to "checkout".
//   2) inventory_reservations.order_item_id - the ERD only ties a
//      reservation to order_id. When one order has two items that need the
//      same ingredient, there is no way to tell which item's reservation to
//      release/consume when THAT item (not the whole order) starts cooking.
//      order_id is kept too, so existing per-order queries still work.
//   3) cart_items.notes / order_items.notes - the ТЗ says the chef should be
//      able to see "особенности приготовления" (cooking notes) per dish, but
//      no field carries that text. Nullable, so it costs nothing if unused.
//   4) The ERD lists both a singular "cart" table and a plural "carts" table
//      with identical columns (a leftover duplicate - cart_items itself
//      points at "Carts"). Only "carts" is modeled here.
//
// Migration 20261011000000_client_accounts_receipts_tracking (Technical_TZ_
// Restaurant_Order_v2.md §3) adds - all additive, nothing renamed or dropped:
//   - recipe personalisation: recipes.adjustment_step / is_customizable,
//     cart_item_ingredients, order_item_ingredients (snapshots)
//   - allergens at ingredient level: ingredient_allergens, allergen_synonyms
//   - client accounts (separate from staff `users`): client_users,
//     client_auth_sessions, client_identity_verifications,
//     client_telegram_links (+ one-time link tokens)
//   - loyalty: loyalty_ledger (append-only; balance = SUM(amount))
//   - orders: client_user_id, comment, subtotal / discount_bonus /
//     payable_total, accepted_at, cancel metadata; carts.comment
//   - order_status_events (append-only timeline), order_ratings
//   - receipts + receipt_dispatches (demo, non-fiscal by default)
//   - idempotency_requests, inventory_adjustments (stock journal)
// Things Prisma cannot express (CHECK constraints, the partial unique index on
// RESERVED reservations, append-only triggers, the receipt number sequence)
// live only in that migration's SQL - Prisma ignores them, which is fine.
// ============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Staff accounts
// ---------------------------------------------------------------------------
model User {
  userId       BigInt   @id @default(autoincrement()) @map("user_id")
  name         String   @db.VarChar(100)
  login        String   @unique @db.VarChar(100)
  passwordHash String   @map("password_hash") @db.Text
  /// Allowed values: ADMIN, WAITER, CHEF
  role         String   @db.VarChar(30)
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")

  ordersAsWaiter       Order[]               @relation("OrderWaiter")
  paymentsReceived     Payment[]             @relation("PaymentPaidBy")
  ageVerificationsDone AgeVerification[]     @relation("AgeVerificationVerifiedBy")
  inventoryAdjustments InventoryAdjustment[] @relation("InventoryAdjustmentActor")

  @@map("users")
}

// ---------------------------------------------------------------------------
// Physical tables, one monitor bolted to each
// ---------------------------------------------------------------------------
model RestaurantTable {
  tableId       BigInt   @id @default(autoincrement()) @map("table_id")
  tableNumber   Int      @unique @map("table_number")
  monitorNumber Int      @unique @map("monitor_number")
  /// Allowed values: FREE, OCCUPIED
  status        String   @default("FREE") @db.VarChar(20)
  createdAt     DateTime @default(now()) @map("created_at")

  sessions RestaurantSession[]
  orders   Order[]

  @@map("tables")
}

// ---------------------------------------------------------------------------
// One visit/seating at a table
// ---------------------------------------------------------------------------
model RestaurantSession {
  sessionId          BigInt          @id @default(autoincrement()) @map("session_id")
  tableId            BigInt          @map("table_id")
  table              RestaurantTable @relation(fields: [tableId], references: [tableId])
  /// Allowed values: ACTIVE, COMPLETED, CANCELLED
  status             String          @default("ACTIVE") @db.VarChar(20)
  createdAt          DateTime        @default(now()) @map("created_at")
  completedAt        DateTime?       @map("completed_at")
  /// SHA-256 of the opaque kiosk session secret (the secret itself is only ever
  /// returned once, by POST /api/sessions/open). TZ §5.2: a numeric session id
  /// alone must never grant access to a cart, order, tracker or receipt.
  kioskTokenHash     String?         @map("kiosk_token_hash") @db.VarChar(64)
  kioskTokenIssuedAt DateTime?       @map("kiosk_token_issued_at")

  cart               Cart?
  orders             Order[]
  ageVerifications   AgeVerification[]
  clientAuthSessions ClientAuthSession[]

  @@map("restaurant_sessions")
}

// ---------------------------------------------------------------------------
// Menu catalog
// ---------------------------------------------------------------------------
model Category {
  categoryId  BigInt  @id @default(autoincrement()) @map("category_id")
  name        String  @unique @db.VarChar(100)
  description String? @db.Text
  imageUrl    String? @map("image_url") @db.Text
  sortOrder   Int     @default(0) @map("sort_order")
  isActive    Boolean @default(true) @map("is_active")

  dishes Dish[]

  @@map("categories")
}

model Dish {
  dishId           BigInt   @id @default(autoincrement()) @map("dish_id")
  categoryId       BigInt   @map("category_id")
  category         Category @relation(fields: [categoryId], references: [categoryId])
  name             String   @db.VarChar(150)
  description      String?  @db.Text
  price            Decimal  @db.Decimal(12, 2)
  imageUrl         String?  @map("image_url") @db.Text
  is21Plus         Boolean  @default(false) @map("is_21_plus")
  isActive         Boolean  @default(true) @map("is_active")
  /// false = a dish with no tracked stock (e.g. an item that is never made
  /// from ingredients). true + empty recipe means "unavailable", never "free".
  inventoryTracked Boolean  @default(true) @map("inventory_tracked")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @default(now()) @updatedAt @map("updated_at")

  recipes          Recipe[]
  cartItems        CartItem[]
  orderItems       OrderItem[]
  availableOptions DishAvailableOption[]
  allergens        DishAllergen[]

  @@map("dishes")
}

model Ingredient {
  ingredientId BigInt   @id @default(autoincrement()) @map("ingredient_id")
  name         String   @unique @db.VarChar(150)
  /// Allowed values: g, kg, ml, l, pcs
  unit         String   @db.VarChar(20)
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")

  recipes               Recipe[]
  inventory             Inventory?
  inventoryReservations InventoryReservation[]
  dishOptionIngredients DishOptionIngredient[]
  allergens             IngredientAllergen[]
  cartItemIngredients   CartItemIngredient[]
  orderItemIngredients  OrderItemIngredient[]
  inventoryAdjustments  InventoryAdjustment[]

  @@map("ingredients")
}

model Recipe {
  recipeId       BigInt     @id @default(autoincrement()) @map("recipe_id")
  dishId         BigInt     @map("dish_id")
  dish           Dish       @relation(fields: [dishId], references: [dishId])
  ingredientId   BigInt     @map("ingredient_id")
  ingredient     Ingredient @relation(fields: [ingredientId], references: [ingredientId])
  /// Default quantity per ONE serving, in Ingredient.unit.
  quantity       Decimal    @db.Decimal(12, 3)
  /// Personalisation step per serving, in Ingredient.unit (> 0). Allowed values
  /// are 0, step, 2*step ... 3*quantity (and `quantity` itself as an anchor).
  adjustmentStep Decimal    @map("adjustment_step") @db.Decimal(12, 3)
  isCustomizable Boolean    @default(true) @map("is_customizable")

  @@unique([dishId, ingredientId])
  @@index([dishId])
  @@map("recipes")
}

// ---------------------------------------------------------------------------
// Stock
// ---------------------------------------------------------------------------
model Inventory {
  inventoryId      BigInt     @id @default(autoincrement()) @map("inventory_id")
  ingredientId     BigInt     @unique @map("ingredient_id")
  ingredient       Ingredient @relation(fields: [ingredientId], references: [ingredientId])
  stockQuantity    Decimal    @map("stock_quantity") @db.Decimal(14, 3)
  reservedQuantity Decimal    @default(0) @map("reserved_quantity") @db.Decimal(14, 3)
  updatedAt        DateTime   @default(now()) @updatedAt @map("updated_at")

  @@map("inventory")
}

model InventoryReservation {
  reservationId BigInt     @id @default(autoincrement()) @map("reservation_id")
  orderId       BigInt     @map("order_id")
  order         Order      @relation(fields: [orderId], references: [orderId])
  // ADDED: see header note (1-to-many ambiguity fix for per-item consume/release)
  orderItemId   BigInt?    @map("order_item_id")
  orderItem     OrderItem? @relation(fields: [orderItemId], references: [orderItemId])
  ingredientId  BigInt     @map("ingredient_id")
  ingredient    Ingredient @relation(fields: [ingredientId], references: [ingredientId])
  quantity      Decimal    @db.Decimal(14, 3)
  /// Allowed values: RESERVED, CONSUMED, RELEASED
  status        String     @db.VarChar(20)
  createdAt     DateTime   @default(now()) @map("created_at")
  releasedAt    DateTime?  @map("released_at")
  consumedAt    DateTime?  @map("consumed_at")

  @@index([orderId])
  @@index([orderItemId])
  @@index([orderItemId, status])
  @@map("inventory_reservations")
}

// ---------------------------------------------------------------------------
// Cart (pre-order, per session)
// ---------------------------------------------------------------------------
model Cart {
  cartId              BigInt            @id @default(autoincrement()) @map("cart_id")
  sessionId           BigInt            @unique @map("session_id")
  session             RestaurantSession @relation(fields: [sessionId], references: [sessionId])
  /// Allowed values: ACTIVE, CONVERTED
  status              String            @default("ACTIVE") @db.VarChar(20)
  /// ONE comment for the whole cart/order (not per dish). Copied into
  /// orders.comment at checkout and cleared with the cart.
  comment             String?           @db.Text
  /// Set by "reorder" when current prices differ from the original order; the
  /// guest must explicitly confirm the new total before checkout is allowed.
  pendingPriceChanges Json?             @map("pending_price_changes")
  createdAt           DateTime          @default(now()) @map("created_at")
  updatedAt           DateTime          @default(now()) @updatedAt @map("updated_at")

  items CartItem[]

  @@map("carts")
}

model CartItem {
  cartItemId BigInt   @id @default(autoincrement()) @map("cart_item_id")
  cartId     BigInt   @map("cart_id")
  cart       Cart     @relation(fields: [cartId], references: [cartId])
  dishId     BigInt   @map("dish_id")
  dish       Dish     @relation(fields: [dishId], references: [dishId])
  quantity   Int
  priceAtAdd Decimal  @map("price_at_add") @db.Decimal(12, 2)
  // ADDED: see header note (chef-visible free-text request, e.g. "no onions")
  notes      String?  @db.Text
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @default(now()) @updatedAt @map("updated_at")

  options     CartItemOption[]
  ingredients CartItemIngredient[]

  @@index([cartId])
  @@map("cart_items")
}

// ADDED (table): see header note (1) - lets chosen options survive into the cart
model CartItemOption {
  cartItemOptionId BigInt     @id @default(autoincrement()) @map("cart_item_option_id")
  cartItemId       BigInt     @map("cart_item_id")
  // FIXED: was ON DELETE RESTRICT, which made removing/clearing a cart item
  // that had options - and checkout's cart cleanup - fail with an FK error.
  cartItem         CartItem   @relation(fields: [cartItemId], references: [cartItemId], onDelete: Cascade)
  optionId         BigInt     @map("option_id")
  option           DishOption @relation(fields: [optionId], references: [optionId])
  /// Units of this option PER SERVING of the dish line (so a line of 2 servings
  /// with quantity 1 consumes/charges the option twice).
  quantity         Int        @default(1)
  priceAtAdd       Decimal    @map("price_at_add") @db.Decimal(12, 2)

  @@index([cartItemId])
  @@map("cart_item_options")
}

// ---------------------------------------------------------------------------
// Dish options (extras / add-ons)
// ---------------------------------------------------------------------------
model DishOption {
  optionId         BigInt  @id @default(autoincrement()) @map("option_id")
  name             String  @db.VarChar(100)
  description      String? @db.Text
  price            Decimal @db.Decimal(12, 2)
  isActive         Boolean @default(true) @map("is_active")
  /// false = a non-stock option (e.g. "no straw"); true with no ingredient rows
  /// is treated as unavailable, never as "always free".
  inventoryTracked Boolean @default(true) @map("inventory_tracked")

  ingredients       DishOptionIngredient[]
  availableOnDishes DishAvailableOption[]
  cartItemOptions   CartItemOption[]
  orderItemOptions  OrderItemOption[]

  @@map("dish_options")
}

model DishOptionIngredient {
  optionId     BigInt     @map("option_id")
  option       DishOption @relation(fields: [optionId], references: [optionId])
  ingredientId BigInt     @map("ingredient_id")
  ingredient   Ingredient @relation(fields: [ingredientId], references: [ingredientId])
  quantity     Decimal    @db.Decimal(12, 3)

  @@id([optionId, ingredientId])
  @@map("dish_option_ingredients")
}

model DishAvailableOption {
  dishId   BigInt     @map("dish_id")
  dish     Dish       @relation(fields: [dishId], references: [dishId])
  optionId BigInt     @map("option_id")
  option   DishOption @relation(fields: [optionId], references: [optionId])

  @@id([dishId, optionId])
  @@map("dish_available_options")
}

// ---------------------------------------------------------------------------
// Orders
// ---------------------------------------------------------------------------
model Order {
  orderId       BigInt            @id @default(autoincrement()) @map("order_id")
  sessionId     BigInt            @map("session_id")
  session       RestaurantSession @relation(fields: [sessionId], references: [sessionId])
  tableId       BigInt            @map("table_id")
  table         RestaurantTable   @relation(fields: [tableId], references: [tableId])
  waiterId      BigInt?           @map("waiter_id")
  waiter        User?             @relation("OrderWaiter", fields: [waiterId], references: [userId])
  /// Owner (only set by an authenticated checkout - guest orders are never
  /// attached to an account after the fact).
  clientUserId  BigInt?           @map("client_user_id")
  clientUser    ClientUser?       @relation(fields: [clientUserId], references: [clientUserId], onDelete: SetNull)
  /// Value of the order before bonus discount (kept as the historical
  /// "total_price"; equals `subtotal`).
  totalPrice    Decimal           @map("total_price") @db.Decimal(12, 2)
  subtotal      Decimal           @db.Decimal(12, 2)
  /// Whole KZT paid with bonuses (1 bonus = 1 KZT).
  discountBonus Int               @default(0) @map("discount_bonus")
  /// Money actually to be paid = subtotal - discount_bonus.
  payableTotal  Decimal           @map("payable_total") @db.Decimal(12, 2)
  /// The single comment for the whole order ("Комментарий для шефа").
  comment       String?           @db.Text
  /// Allowed values: CREATED, SENT_TO_KITCHEN, READY_FOR_DELIVERY, OUT_FOR_DELIVERY, DELIVERED, CANCELLED
  orderStatus   String            @map("order_status") @db.VarChar(30)
  /// Allowed values: WAITING_FOR_PAYMENT, WAITING_FOR_CASH, PAID
  paymentStatus String            @map("payment_status") @db.VarChar(30)
  createdAt     DateTime          @default(now()) @map("created_at")
  updatedAt     DateTime          @default(now()) @updatedAt @map("updated_at")
  acceptedAt    DateTime?         @map("accepted_at")
  deliveredAt   DateTime?         @map("delivered_at")
  cancelledAt   DateTime?         @map("cancelled_at")
  cancelReason  String?           @map("cancel_reason") @db.Text

  items                 OrderItem[]
  payments              Payment[]
  inventoryReservations InventoryReservation[]
  ageVerifications      AgeVerification[]
  statusEvents          OrderStatusEvent[]
  receipt               Receipt?
  rating                OrderRating?
  loyaltyEntries        LoyaltyLedger[]
  telegramReceiptClaims TelegramReceiptClaim[]

  @@index([sessionId])
  @@index([tableId])
  @@index([clientUserId, createdAt(sort: Desc)])
  @@index([sessionId, createdAt(sort: Desc)])
  @@map("orders")
}

model OrderItem {
  orderItemId BigInt    @id @default(autoincrement()) @map("order_item_id")
  orderId     BigInt    @map("order_id")
  order       Order     @relation(fields: [orderId], references: [orderId])
  dishId      BigInt    @map("dish_id")
  dish        Dish      @relation(fields: [dishId], references: [dishId])
  quantity    Int
  price       Decimal   @db.Decimal(12, 2)
  /// Allowed values: WAITING, PREPARING, READY, HANDED_TO_WAITER, DELIVERED
  status      String    @db.VarChar(30)
  // ADDED: see header note (3)
  notes       String?   @db.Text
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @default(now()) @updatedAt @map("updated_at")
  deliveredAt DateTime? @map("delivered_at")

  options               OrderItemOption[]
  ingredients           OrderItemIngredient[]
  inventoryReservations InventoryReservation[]

  @@index([orderId])
  @@map("order_items")
}

model OrderItemOption {
  orderItemOptionId BigInt     @id @default(autoincrement()) @map("order_item_option_id")
  orderItemId       BigInt     @map("order_item_id")
  orderItem         OrderItem  @relation(fields: [orderItemId], references: [orderItemId])
  optionId          BigInt     @map("option_id")
  option            DishOption @relation(fields: [optionId], references: [optionId])
  quantity          Int
  price             Decimal    @db.Decimal(12, 2)

  @@index([orderItemId])
  @@map("order_item_options")
}

// ---------------------------------------------------------------------------
// Payments
// ---------------------------------------------------------------------------
model Payment {
  paymentId    BigInt    @id @default(autoincrement()) @map("payment_id")
  orderId      BigInt    @map("order_id")
  order        Order     @relation(fields: [orderId], references: [orderId])
  /// Allowed values: KASPI_QR, CASH
  method       String    @db.VarChar(20)
  /// Allowed values: WAITING_FOR_CASH, PAID
  status       String    @db.VarChar(30)
  /// Money only (after the bonus discount) - equals orders.payable_total.
  amount       Decimal   @db.Decimal(12, 2)
  /// Whole KZT covered by bonuses for this order (not part of `amount`).
  bonusUsed    Int       @default(0) @map("bonus_used")
  /// Unique reference of the payment attempt (idempotent payments). For the
  /// classroom KASPI_QR simulation this is a generated DEMO-... value.
  providerRef  String?   @unique @map("provider_ref") @db.VarChar(100)
  /// true = simulated payment (RFID/Arduino demo) - never a real bank charge.
  isDemo       Boolean   @default(false) @map("is_demo")
  /// Allowed values: NONE, REFUND_REQUIRED. REFUND_REQUIRED means money must be
  /// returned through the real payment channel - this system never fakes it.
  refundStatus String    @default("NONE") @map("refund_status") @db.VarChar(30)
  createdAt    DateTime  @default(now()) @map("created_at")
  paidAt       DateTime? @map("paid_at")
  paidBy       BigInt?   @map("paid_by")
  paidByUser   User?     @relation("PaymentPaidBy", fields: [paidBy], references: [userId])

  @@index([orderId])
  @@map("payments")
}

// ---------------------------------------------------------------------------
// Age verification (21+)
// ---------------------------------------------------------------------------
model AgeVerification {
  verificationId BigInt            @id @default(autoincrement()) @map("verification_id")
  sessionId      BigInt            @map("session_id")
  session        RestaurantSession @relation(fields: [sessionId], references: [sessionId])
  orderId        BigInt?           @map("order_id")
  order          Order?            @relation(fields: [orderId], references: [orderId])
  verified       Boolean           @map("verified")
  verifiedBy     BigInt            @map("verified_by")
  verifiedByUser User              @relation("AgeVerificationVerifiedBy", fields: [verifiedBy], references: [userId])
  verifiedAt     DateTime?         @map("verified_at")
  createdAt      DateTime          @default(now()) @map("created_at")

  @@index([sessionId])
  @@map("age_verifications")
}

// ---------------------------------------------------------------------------
// Allergens
// ---------------------------------------------------------------------------
/// One of the 20 allergen CATEGORIES from the requirements. `description`
/// lists representative products of the category (classification only - not a
/// claim that every member is a legal allergen).
model Allergen {
  allergenId  BigInt  @id @default(autoincrement()) @map("allergen_id")
  name        String  @unique @db.VarChar(100)
  description String? @db.Text
  sortOrder   Int     @default(0) @map("sort_order")

  dishes      DishAllergen[]
  ingredients IngredientAllergen[]
  synonyms    AllergenSynonym[]

  @@map("allergens")
}

model DishAllergen {
  dishId     BigInt   @map("dish_id")
  dish       Dish     @relation(fields: [dishId], references: [dishId])
  allergenId BigInt   @map("allergen_id")
  allergen   Allergen @relation(fields: [allergenId], references: [allergenId])

  @@id([dishId, allergenId])
  @@map("dish_allergens")
}

// ============================================================================
// Technical_TZ_Restaurant_Order_v2.md - new tables
// ============================================================================

// ---------------------------------------------------------------------------
// Ingredient-level allergen tags
// ---------------------------------------------------------------------------
model IngredientAllergen {
  ingredientId BigInt     @map("ingredient_id")
  ingredient   Ingredient @relation(fields: [ingredientId], references: [ingredientId])
  allergenId   BigInt     @map("allergen_id")
  allergen     Allergen   @relation(fields: [allergenId], references: [allergenId])
  /// CONTAINS = the ingredient itself belongs to the category;
  /// MAY_CONTAIN = traces / cross-contact (shown separately in the UI).
  kind         String     @default("CONTAINS") @db.VarChar(20)

  @@id([ingredientId, allergenId])
  @@index([allergenId])
  @@map("ingredient_allergens")
}

/// Old/alternative names → canonical category ("Молоко" → "Молоко и молочные
/// продукты") so reseeding never duplicates or orphans a category.
model AllergenSynonym {
  synonym    String   @id @db.VarChar(100)
  allergenId BigInt   @map("allergen_id")
  allergen   Allergen @relation(fields: [allergenId], references: [allergenId])

  @@index([allergenId])
  @@map("allergen_synonyms")
}

// ---------------------------------------------------------------------------
// Personalised composition snapshots
// ---------------------------------------------------------------------------
model CartItemIngredient {
  cartItemIngredientId BigInt     @id @default(autoincrement()) @map("cart_item_ingredient_id")
  cartItemId           BigInt     @map("cart_item_id")
  cartItem             CartItem   @relation(fields: [cartItemId], references: [cartItemId], onDelete: Cascade)
  ingredientId         BigInt     @map("ingredient_id")
  ingredient           Ingredient @relation(fields: [ingredientId], references: [ingredientId])
  /// Recipe default per ONE serving at the time the line was added.
  baseQuantity         Decimal    @map("base_quantity") @db.Decimal(12, 3)
  /// What the guest chose per ONE serving (0 = remove the ingredient).
  selectedQuantity     Decimal    @map("selected_quantity") @db.Decimal(12, 3)
  unitSnapshot         String     @map("unit_snapshot") @db.VarChar(20)

  @@unique([cartItemId, ingredientId])
  @@map("cart_item_ingredients")
}

model OrderItemIngredient {
  orderItemIngredientId  BigInt     @id @default(autoincrement()) @map("order_item_ingredient_id")
  orderItemId            BigInt     @map("order_item_id")
  orderItem              OrderItem  @relation(fields: [orderItemId], references: [orderItemId])
  ingredientId           BigInt     @map("ingredient_id")
  ingredient             Ingredient @relation(fields: [ingredientId], references: [ingredientId])
  ingredientNameSnapshot String     @map("ingredient_name_snapshot") @db.VarChar(150)
  unitSnapshot           String     @map("unit_snapshot") @db.VarChar(20)
  /// Recipe default per serving when the order was placed (0 for OPTION rows).
  basePerServing         Decimal    @map("base_per_serving") @db.Decimal(12, 3)
  selectedPerServing     Decimal    @map("selected_per_serving") @db.Decimal(12, 3)
  /// selectedPerServing * servings - exactly what was reserved for this line.
  requiredTotal          Decimal    @map("required_total") @db.Decimal(14, 3)
  /// Allowed values: RECIPE, OPTION
  source                 String     @db.VarChar(10)

  @@unique([orderItemId, ingredientId, source])
  @@index([orderItemId])
  @@map("order_item_ingredients")
}

// ---------------------------------------------------------------------------
// Stock journal
// ---------------------------------------------------------------------------
model InventoryAdjustment {
  adjustmentId BigInt     @id @default(autoincrement()) @map("adjustment_id")
  ingredientId BigInt     @map("ingredient_id")
  ingredient   Ingredient @relation(fields: [ingredientId], references: [ingredientId])
  delta        Decimal    @db.Decimal(14, 3)
  stockBefore  Decimal    @map("stock_before") @db.Decimal(14, 3)
  stockAfter   Decimal    @map("stock_after") @db.Decimal(14, 3)
  /// Allowed values: INITIAL, RECEIPT, CORRECTION, WRITE_OFF
  reason       String     @db.VarChar(20)
  comment      String?    @db.VarChar(500)
  actorUserId  BigInt?    @map("actor_user_id")
  actor        User?      @relation("InventoryAdjustmentActor", fields: [actorUserId], references: [userId], onDelete: SetNull)
  createdAt    DateTime   @default(now()) @map("created_at")

  @@index([ingredientId, createdAt(sort: Desc)])
  @@map("inventory_adjustments")
}

// ---------------------------------------------------------------------------
// Client accounts (completely separate from staff `users`)
// ---------------------------------------------------------------------------
model ClientUser {
  clientUserId      BigInt    @id @default(autoincrement()) @map("client_user_id")
  name              String    @db.VarChar(100)
  /// Normalised (trimmed, lower-case). NULL after account deletion.
  email             String?   @unique @db.VarChar(254)
  passwordHash      String?   @map("password_hash") @db.Text
  isActive          Boolean   @default(true) @map("is_active")
  createdAt         DateTime  @default(now()) @map("created_at")
  deletedAt         DateTime? @map("deleted_at")
  passwordChangedAt DateTime? @map("password_changed_at")
  /// CACHE of SUM(loyalty_ledger.amount) - the ledger is the source of truth.
  bonusBalance      Int       @default(0) @map("bonus_balance")

  authSessions   ClientAuthSession[]
  orders         Order[]
  ledger         LoyaltyLedger[]
  identityChecks ClientIdentityVerification[]
  ratings        OrderRating[]
  telegramLink   ClientTelegramLink?
  telegramAutoDeliveries TelegramAutoDelivery[]

  @@map("client_users")
}

/// One row per issued client JWT (jti). Lets logout / password change / account
/// deletion really revoke tokens, and ties a login on a shared kiosk to that
/// restaurant session so it dies when the table is released.
model ClientAuthSession {
  jti            String             @id @db.VarChar(36)
  clientUserId   BigInt             @map("client_user_id")
  clientUser     ClientUser         @relation(fields: [clientUserId], references: [clientUserId], onDelete: Cascade)
  kioskSessionId BigInt?            @map("kiosk_session_id")
  kioskSession   RestaurantSession? @relation(fields: [kioskSessionId], references: [sessionId], onDelete: SetNull)
  createdAt      DateTime           @default(now()) @map("created_at")
  expiresAt      DateTime           @map("expires_at")
  revokedAt      DateTime?          @map("revoked_at")

  @@index([clientUserId])
  @@index([kioskSessionId])
  @@map("client_auth_sessions")
}

model ClientIdentityVerification {
  verificationId    BigInt     @id @default(autoincrement()) @map("verification_id")
  clientUserId      BigInt     @map("client_user_id")
  clientUser        ClientUser @relation(fields: [clientUserId], references: [clientUserId], onDelete: Cascade)
  /// Allowed values: UNVERIFIED, PENDING, VERIFIED, REJECTED, EXPIRED
  status            String     @db.VarChar(20)
  /// Allowed values: DEMO, PROVIDER. DEMO is a simulation and is NEVER accepted
  /// as an age waiver in production.
  mode              String     @db.VarChar(20)
  verifiedAt        DateTime?  @map("verified_at")
  expiresAt         DateTime?  @map("expires_at")
  /// Opaque reference from the provider (or a demo marker). Never a document
  /// number, never an image - the uploaded file is not stored.
  providerReference String?    @map("provider_reference") @db.VarChar(100)
  createdAt         DateTime   @default(now()) @map("created_at")

  @@index([clientUserId, createdAt(sort: Desc)])
  @@map("client_identity_verifications")
}

model ClientTelegramLink {
  linkId         BigInt     @id @default(autoincrement()) @map("link_id")
  clientUserId   BigInt     @unique @map("client_user_id")
  clientUser     ClientUser @relation(fields: [clientUserId], references: [clientUserId], onDelete: Cascade)
  telegramChatId String     @unique @map("telegram_chat_id") @db.VarChar(40)
  verifiedAt     DateTime   @map("verified_at")
  autoReceipts   Boolean    @default(false) @map("auto_receipts")

  @@map("client_telegram_links")
}

/// One-time deep-link tokens (stored hashed) for binding a Telegram chat.
model ClientTelegramLinkToken {
  tokenHash    String    @id @map("token_hash") @db.VarChar(64)
  clientUserId BigInt    @map("client_user_id")
  expiresAt    DateTime  @map("expires_at")
  usedAt       DateTime? @map("used_at")

  @@index([clientUserId])
  @@map("client_telegram_link_tokens")
}

// ---------------------------------------------------------------------------
// Loyalty (append-only ledger)
// ---------------------------------------------------------------------------
model LoyaltyLedger {
  ledgerId       BigInt     @id @default(autoincrement()) @map("ledger_id")
  clientUserId   BigInt     @map("client_user_id")
  clientUser     ClientUser @relation(fields: [clientUserId], references: [clientUserId])
  orderId        BigInt     @map("order_id")
  order          Order      @relation(fields: [orderId], references: [orderId])
  /// Allowed values: EARN (+), SPEND (-), REVERSE_EARN (-), REFUND_SPEND (+)
  type           String     @db.VarChar(20)
  /// Signed whole bonuses (1 bonus = 1 KZT).
  amount         Int
  /// Human-readable explanation of the operation's current meaning.
  note           String?    @db.VarChar(255)
  createdAt      DateTime   @default(now()) @map("created_at")
  idempotencyKey String     @unique @map("idempotency_key") @db.VarChar(100)

  @@unique([orderId, type])
  @@index([clientUserId, createdAt])
  @@map("loyalty_ledger")
}

// ---------------------------------------------------------------------------
// Ratings, timeline
// ---------------------------------------------------------------------------
model OrderRating {
  ratingId     BigInt     @id @default(autoincrement()) @map("rating_id")
  orderId      BigInt     @unique @map("order_id")
  order        Order      @relation(fields: [orderId], references: [orderId])
  clientUserId BigInt     @map("client_user_id")
  clientUser   ClientUser @relation(fields: [clientUserId], references: [clientUserId])
  /// 1..5 (CHECK constraint in SQL)
  rating       Int
  createdAt    DateTime   @default(now()) @map("created_at")

  @@map("order_ratings")
}

/// Append-only (trigger-enforced). One row per business event per order.
model OrderStatusEvent {
  eventId    BigInt   @id @default(autoincrement()) @map("event_id")
  orderId    BigInt   @map("order_id")
  order      Order    @relation(fields: [orderId], references: [orderId])
  /// Order/stage status at the event: SENT_TO_KITCHEN, PREPARING (first item
  /// started cooking), READY_FOR_DELIVERY, OUT_FOR_DELIVERY, DELIVERED, CANCELLED
  status     String   @db.VarChar(30)
  occurredAt DateTime @default(now()) @map("occurred_at")
  /// Allowed values: SYSTEM, GUEST, CLIENT, STAFF
  actorType  String   @map("actor_type") @db.VarChar(20)
  actorId    BigInt?  @map("actor_id")
  /// Allowed values: ORDER_CREATED, PAYMENT_CONFIRMED, COOKING_STARTED,
  /// READY_FOR_DELIVERY, OUT_FOR_DELIVERY, DELIVERED, CANCELLED
  eventType  String   @map("event_type") @db.VarChar(30)

  @@unique([orderId, eventType])
  @@index([orderId, occurredAt])
  @@map("order_status_events")
}

// ---------------------------------------------------------------------------
// Receipts
// ---------------------------------------------------------------------------
/// Immutable snapshot taken when the payment becomes PAID (trigger-enforced).
model Receipt {
  receiptId       BigInt   @id @default(autoincrement()) @map("receipt_id")
  orderId         BigInt   @unique @map("order_id")
  order           Order    @relation(fields: [orderId], references: [orderId])
  receiptNumber   String   @unique @map("receipt_number") @db.VarChar(40)
  /// Allowed values: DEMO, FISCAL
  kind            String   @db.VarChar(10)
  payloadJson     Json     @map("payload_json")
  issuedAt        DateTime @map("issued_at")
  /// Allowed values: NOT_CONFIGURED, PENDING, SUCCEEDED, FAILED
  fiscalStatus    String   @map("fiscal_status") @db.VarChar(20)
  fiscalReference String?  @map("fiscal_reference") @db.VarChar(100)
  verificationUrl String?  @map("verification_url") @db.Text

  dispatches ReceiptDispatch[]
  autoDelivery TelegramAutoDelivery?

  @@map("receipts")
}

model ReceiptDispatch {
  dispatchId          BigInt    @id @default(autoincrement()) @map("dispatch_id")
  receiptId           BigInt    @map("receipt_id")
  receipt             Receipt   @relation(fields: [receiptId], references: [receiptId])
  /// Allowed values: EMAIL, TELEGRAM
  channel             String    @db.VarChar(20)
  /// e.g. "a***@g***.com" - the full address is never stored here.
  destinationMasked   String    @map("destination_masked") @db.VarChar(120)
  /// Allowed values: PENDING, SENT, FAILED, NOT_CONFIGURED
  status              String    @db.VarChar(20)
  attempts            Int       @default(0)
  lastError           String?   @map("last_error") @db.VarChar(500)
  requestedByClientId BigInt?   @map("requested_by_client_id")
  createdAt           DateTime  @default(now()) @map("created_at")
  sentAt              DateTime? @map("sent_at")

  @@index([receiptId, createdAt])
  @@map("receipt_dispatches")
}

// ---------------------------------------------------------------------------
// Idempotency
// ---------------------------------------------------------------------------
model IdempotencyRequest {
  id          BigInt   @id @default(autoincrement())
  key         String   @db.VarChar(100)
  scope       String   @db.VarChar(60)
  ownerId     String   @map("owner_id") @db.VarChar(40)
  /// Hash of the request body: same key + different body = IDEMPOTENCY_CONFLICT.
  requestHash String   @map("request_hash") @db.VarChar(64)
  /// e.g. the created order id; NULL while the first request is in flight.
  responseRef String?  @map("response_ref") @db.VarChar(100)
  createdAt   DateTime @default(now()) @map("created_at")

  @@unique([key, scope, ownerId])
  @@index([createdAt])
  @@map("idempotency_requests")
}

// Telegram bot: short-lived opaque claims and durable webhook/notification bookkeeping.
model TelegramBotLoginRequest {
  tokenHash String   @id @map("token_hash") @db.VarChar(64)
  chatId    String   @map("chat_id") @db.VarChar(40)
  expiresAt DateTime @map("expires_at")
  usedAt    DateTime? @map("used_at")
  @@index([chatId, expiresAt])
  @@map("telegram_bot_login_requests")
}

model TelegramReceiptClaim {
  tokenHash String   @id @map("token_hash") @db.VarChar(64)
  orderId   BigInt   @map("order_id")
  order Order @relation(fields: [orderId], references: [orderId], onDelete: Cascade)
  expiresAt DateTime @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime @default(now()) @map("created_at")
  @@index([orderId, expiresAt])
  @@map("telegram_receipt_claims")
}

model TelegramProcessedUpdate {
  updateId BigInt   @id @map("update_id")
  createdAt DateTime @default(now()) @map("created_at")
  @@map("telegram_processed_updates")
}

model TelegramAutoDelivery {
  receiptId    BigInt    @id @map("receipt_id")
  clientUserId BigInt    @map("client_user_id")
  receipt Receipt @relation(fields: [receiptId], references: [receiptId], onDelete: Cascade)
  clientUser ClientUser @relation(fields: [clientUserId], references: [clientUserId], onDelete: Cascade)
  status       String    @default("PENDING") @db.VarChar(20)
  attempts     Int       @default(0)
  nextAttemptAt DateTime @default(now()) @map("next_attempt_at")
  lockedAt      DateTime? @map("locked_at")
  lastError     String?   @map("last_error") @db.VarChar(300)
  sentAt        DateTime? @map("sent_at")
  @@index([status, nextAttemptAt])
  @@index([clientUserId, status])
  @@map("telegram_auto_deliveries")
}
